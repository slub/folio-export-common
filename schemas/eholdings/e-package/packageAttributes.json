{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Package Object Data Attributes Schema",
  "description": "Package Object Data Attributes Schema",
  "PackageAttributes": {
    "type": "object",
    "properties": {
      "contentType": {
        "type": "string",
        "description": "Content Type of Package",
        "$ref": "../contentTypeEnum.json#/ContentTypeEnum",
        "example": "Online Reference"
      },
      "customCoverage": {
        "type": "object",
        "description": "Custom Coverage",
        "$ref": "../coverage.json#/Coverage"
      },
      "isCustom": {
        "type": "boolean",
        "description": "Whether this package is custom or not",
        "example": false
      },
      "isSelected": {
        "type": "boolean",
        "description": "Whether this package is selected or not",
        "example": false
      },
      "name": {
        "type": "string",
        "description": "Package name",
        "example": "Shenbao"
      },
      "customDisplayName": {
        "type": "string",
        "description": "Custom display name of the package"
      },
      "managedAltNames": {
        "type": "array",
        "description": "The list of managed alternate names for the package",
        "items": {
          "type": "object",
          "$ref": "packageAltName.json#/PackageAltName"
        }
      },
      "customAltNames": {
        "type": "array",
        "description": "The list of custom alternate names for the package",
        "items": {
          "type": "object",
          "$ref": "packageAltName.json#/PackageAltName"
        }
      },
      "managedDescription": {
        "type": "string",
        "description": "The managed description of the package"
      },
      "customDescription": {
        "type": "string",
        "description": "The custom description of the package"
      },
      "isFreeAccess": {
        "type": "boolean",
        "description": "Whether this package has free access designation or not",
        "example": false
      },
      "packageId": {
        "type": "string",
        "description": "Package Id",
        "example": 1152699
      },
      "packageType": {
        "type": "string",
        "description": "Package type",
        "example": "Complete"
      },
      "providerId": {
        "type": "string",
        "description": "Provider Id",
        "example": 91525
      },
      "providerName": {
        "type": "string",
        "description": "Provider name",
        "example": "Green Apple - Qingpingguo"
      },
      "selectedCount": {
        "type": "integer",
        "description": "Selected count",
        "example": 0
      },
      "titleCount": {
        "type": "integer",
        "description": "Title count",
        "example": 1
      },
      "visibility": {
        "type": "array",
        "description": "Visibility details per category",
        "items": {
          "type": "object",
          "$ref": "packageVisibility.json#/PackageVisibility"
        }
      },
      "allowKbToAddTitles": {
        "type": "boolean",
        "description": "Allow KB to add titles",
        "example": true
      },
      "packageToken": {
        "type": "object",
        "description": "Package Token",
        "$ref": "../token.json#/Token"
      },
      "proxy": {
        "type": "object",
        "description": "Proxy",
        "$ref": "../proxy.json#/Proxy"
      },
      "tags": {
        "type": "object",
        "description": "Package tags",
        "$ref": "../tags.json#/Tags"
      }
    }
  }
}
